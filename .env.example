# Is file ko copy karke ".env" naam se save karein aur apni values likhein
DB_HOST=sqlXXX.infinityfree.com
DB_USER=if0_XXXXXXXX
DB_PASSWORD=your_db_password
DB_NAME=if0_XXXXXXXX_job_portal

# Aam taur par ye line na likhein, folder ka path khud detect hota hai.
# Sirf tab likhein jab links galat aayen, e.g. APP_BASE_PATH=/job-portal
# APP_BASE_PATH=
# Live site par apna address likhein (end mein / nahi). Localhost par hata dein.
# APP_URL=https://yoursite.rf.gd
APP_NAME="Job Portal"

# Email (password reset / notifications ke liye). Free hosting par SMTP block ho sakta hai.
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=youremail@gmail.com
SMTP_PASSWORD=gmail_app_password
SMTP_ENCRYPTION=tls
SMTP_PORT=587
